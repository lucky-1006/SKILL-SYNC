# =============================================================================
# SkillSync Backend Environment Configuration Template
# SIH 2026 Problem Statement 26044 — Academia–Industry Collaboration Portal
# =============================================================================

# --- Application Configuration ---
NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

# --- Database (PostgreSQL + Prisma) ---
# For local zero-config testing: file:./dev.db
# For production PostgreSQL: postgresql://postgres:password123@localhost:5432/skillsync?schema=public
DATABASE_URL=file:./dev.db
DIRECT_DATABASE_URL=postgresql://postgres:password123@localhost:5432/skillsync?schema=public

# --- Authentication & JWT ---
# IMPORTANT: Generate a strong 64-character secret in production (e.g. openssl rand -base64 48)
JWT_SECRET=skillsync-sih-2026-master-jwt-authentication-secret-token-key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=skillsync-sih-2026-master-jwt-refresh-token-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# --- OAuth Providers (Optional / Conditional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# --- AI & LLM Providers ---
# Supported AI_PROVIDER values: groq | openai | gemini | anthropic
AI_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Provide the API key for the selected AI_PROVIDER:
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings (Multi-Model Architecture) ---
# Supported EMBEDDING_PROVIDER values: dense-local | openai
EMBEDDING_PROVIDER=dense-local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- Context Reranker ---
# Supported RERANKER_PROVIDER values: cross-encoder | cohere | disabled
RERANKER_PROVIDER=cross-encoder
RERANKER_MODEL=ms-marco-MiniLM-L-6-v2

# --- Vector Database (PostgreSQL + pgvector) ---
VECTOR_DATABASE_URL=postgresql://postgres:password123@localhost:5432/skillsync
VECTOR_TABLE=skill_embeddings

# --- Redis & Queue (Caching & BullMQ) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_REDIS_URL=redis://localhost:6379/1

# --- File & Object Storage ---
# Supported STORAGE_PROVIDER values: local | s3
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=skillsync-resumes
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AWS S3 Specifics (Optional if S3-compatible storage like MinIO is used)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=skillsync-resumes

# --- Email Notifications & Dispatch ---
# Supported EMAIL_PROVIDER values: console | smtp | sendgrid
EMAIL_PROVIDER=console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@skillsync.edu

# --- System Notifications ---
NOTIFICATION_ENABLED=true

# --- Document AI & ATS Processing ---
# Supported values: internal-parser | aws-textract | google-docai
OCR_PROVIDER=internal
DOCUMENT_AI_PROVIDER=internal-parser

# --- External Search & Verification APIs ---
# Supported values: internal | searxng | bing
SEARCH_PROVIDER=internal
SEARCH_API_KEY=
SEARCH_BASE_URL=
SEARXNG_URL=

# --- External Opportunity Providers & Real Data Sync ---
# Official Adzuna Job Search API (https://developer.adzuna.com/)
ADZUNA_ENABLED=false
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=in

# Official Udemy Affiliate/Course API
UDEMY_ENABLED=false
UDEMY_CLIENT_ID=your_udemy_client_id_here
UDEMY_CLIENT_SECRET=your_udemy_client_secret_here

# Opportunity Background Sync Scheduler
OPPORTUNITY_SYNC_ENABLED=true
OPPORTUNITY_SYNC_INTERVAL_MINUTES=60

# --- Security & Encryption ---
ENCRYPTION_KEY=skillsync-32-char-encryption-key-sih2026
SESSION_SECRET=skillsync-session-security-token-secret

