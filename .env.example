# =============================================================================
# SkillSync Monorepo Root Environment Configuration Template
# SIH 2026 Problem Statement 26044 — Academia–Industry Collaboration Portal
# =============================================================================

# Docker Compose Service Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_DB=skillsync
POSTGRES_PORT=5432

REDIS_PORT=6379

# Service Ports
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Backend & JWT
JWT_SECRET=skillsync-sih-2026-master-jwt-authentication-secret-token-key
DATABASE_URL=postgresql://postgres:password123@postgres:5432/skillsync?schema=public

# AI Provider Configuration
AI_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Public Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# External Opportunity Providers (Adzuna, Udemy)
ADZUNA_ENABLED=false
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=in
UDEMY_ENABLED=false
UDEMY_CLIENT_ID=your_udemy_client_id_here
UDEMY_CLIENT_SECRET=your_udemy_client_secret_here
OPPORTUNITY_SYNC_ENABLED=true
OPPORTUNITY_SYNC_INTERVAL_MINUTES=60

